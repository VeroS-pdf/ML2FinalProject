set.seed(42)
library(brms)
library(forcats)
library(pROC)
pets <- read.csv("pet_adoption_data.csv")
head(pets)
table(pets$AdoptionLikelihood, useNA = "ifany")
model_cols <- c(
"AdoptionLikelihood", "AgeMonths", "Breed", "PetType", "HealthCondition",
"Vaccinated", "AdoptionFee", "TimeInShelterDays", "PreviousOwner", "WeightKg"
)
missing_cols <- setdiff(model_cols, names(pets))
if (length(missing_cols) > 0) stop("Missing columns: ", paste(missing_cols, collapse = ", "))
colSums(is.na(pets[model_cols]))
pets_scaled <- pets
pets_scaled$Breed <- fct_lump(as.factor(pets$Breed), n = 5)
# numeric features get scaled
pets_scaled$AgeMonths <- as.numeric(scale(pets$AgeMonths))
pets_scaled$AdoptionFee <- as.numeric(scale(pets$AdoptionFee))
pets_scaled$WeightKg <- as.numeric(scale(pets$WeightKg))
pets_scaled$TimeInShelterDays <- as.numeric(scale(pets$TimeInShelterDays))
# categorical features
pets_scaled$PetType <- as.factor(pets$PetType)
pets_scaled$HealthCondition <- as.factor(pets$HealthCondition)
pets_scaled$Vaccinated <- as.factor(pets$Vaccinated)
pets_scaled$PreviousOwner <- as.factor(pets$PreviousOwner)
# check Bernoulli outcome
stopifnot(all(pets_scaled$AdoptionLikelihood %in% c(0, 1)))
n <- nrow(pets_scaled)
train_idx <- sample(1:n, size = 0.8 * n)
train_data <- pets_scaled[train_idx, ]
test_data  <- pets_scaled[-train_idx, ]
n_chains <- 4
n_iter <- 2000
n_warmup <- 1000
# stronger priors might help..?
prior <- c(
prior(normal(0, 0.5), class = "b"),
prior(normal(0, 1), class = "Intercept")
)
# try taking out breed
model <- brm(
AdoptionLikelihood ~ AgeMonths + PetType + HealthCondition + Vaccinated +
AdoptionFee + TimeInShelterDays + PreviousOwner + WeightKg + (1 | Breed)
,
family = bernoulli("logit"),
data = train_data,
chains = n_chains,
cores = 4,
seed = 42,
warmup = n_warmup,
iter = n_iter,
refresh = 100,
control = list(
adapt_delta = 0.99,
max_treedepth = 15
)
)
n_chains <- 4
n_iter <- 2000
n_warmup <- 1000
# stronger priors might help..?
prior <- c(
prior(normal(0, 0.5), class = "b"),
prior(normal(0, 1), class = "Intercept")
)
# try taking out breed
model <- brm(
AdoptionLikelihood ~ AgeMonths + PetType + HealthCondition + Vaccinated +
AdoptionFee + TimeInShelterDays + PreviousOwner + WeightKg + (1 | Breed)
,
family = bernoulli("logit"),
data = train_data,
chains = n_chains,
cores = 4,
seed = 42,
warmup = n_warmup,
iter = n_iter,
refresh = 100,
control = list(
adapt_delta = 0.99,
max_treedepth = 15
)
)
saveRDS(model, "bayes_model_fit_5.rds")
library("pROC")
summary(model)
pred_probs <- fitted(model, newdata = test_data)[, "Estimate"]
pred_class <- ifelse(pred_probs > 0.5, 1, 0)
# labels must match newdata rows (test set), not the full scaled frame
y_test <- test_data$AdoptionLikelihood
mean(pred_class == y_test)
roc_obj <- roc(y_test, pred_probs)
auc(roc_obj)
# visualizations from the model that can help us draw conclusions about the data
library(brms)
library(ggplot2)
mcmc_plot(model, type = "intervals") +
ggtitle("Posterior Estimates with 95% Credible Intervals")
# visualizations from the model that can help us draw conclusions about the data
library(brms)
library(ggplot2)
mcmc_plot(model, type = "intervals") +
ggtitle("Posterior Estimates with 95% Credible Intervals")
plot(conditional_effects(model), ask = FALSE)
library("pROC")
summary(model)
pred_probs <- fitted(model, newdata = test_data)[, "Estimate"]
pred_class <- ifelse(pred_probs > 0.5, 1, 0)
y_test <- test_data$AdoptionLikelihood
mean(pred_class == y_test)
roc_obj <- roc(y_test, pred_probs)
auc(roc_obj)
pred_probs <- fitted(model, newdata = test_data)[, "Estimate"]
# convert to class predictions (threshold = 0.5)
pred_class <- ifelse(pred_probs > 0.5, 1, 0)
# accuracy
accuracy <- mean(pred_class == test_data$AdoptionLikelihood)
accuracy
library("pROC")
summary(model)
roc_obj <- roc(test_data$AdoptionLikelihood, pred_probs)
best_thresh <- coords(roc_obj, "best", ret = "threshold")
best_thresh
pred_class_opt <- ifelse(pred_probs > best_thresh, 1, 0)
mean(pred_class_opt == test_data$AdoptionLikelihood)
