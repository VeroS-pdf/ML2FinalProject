set.seed(42)
library(brms)
library(forcats)
n_chains <- 2
n_iter <- 2000
n_warmup <- 1000
# stronger priors might help..?
prior <- c(
prior(normal(0, 1), class = "b"),
prior(normal(0, 2), class = "Intercept")
)
model <- brm(
AdoptionLikelihood ~ AgeMonths + Breed + PetType + HealthCondition + Vaccinated +
AdoptionFee + TimeInShelterDays + PreviousOwner + WeightKg,
family = bernoulli("logit"),
data = pets_scaled,
chains = n_chains,
cores = 4,
seed = 42,
warmup = n_warmup,
iter = n_iter,
refresh = 100,
control = list(
adapt_delta = 0.99,
max_treedepth = 15
)
)
saveRDS(model, "bayes_model_fit.rds")
summary(model)
saveRDS(model, "bayes_model_fit_v1.rds")
